{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket Lens",
  "version": "0.3.0",
  "identifier": "dev.beldi.pocketlens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pocket Lens",
        "width": 1180,
        "height": 790,
        "minWidth": 850,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "vendor/scrcpy/": "scrcpy/"
    },
    "category": "Utility",
    "publisher": "Diego Joel Robles Muñoz",
    "shortDescription": "Your Android devices, one simple desktop",
    "copyright": "Copyright © 2026 Diego Joel Robles Muñoz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Beldi13/pocket-lens/releases/latest/download/latest.json"
      ],
      "allowDowngrades": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMTBENjMwNTEwMTg3QzYKUldUR2h3RlJNTllRd3d5eDNQQ3lVN3NJYThBbDRrWHdReEVNWURXKy9Nd3VGOUM4ZC8wcEh2WWUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
